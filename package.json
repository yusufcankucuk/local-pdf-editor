{
  "name": "local-pdf-editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "format": "prettier --write src tests/*.ts vite.config.ts scripts/*.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "lucide-react": "^0.468.0",
    "mupdf": "^1.28.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
